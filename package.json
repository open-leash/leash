{
  "name": "leash",
  "private": true,
  "version": "0.37.12",
  "description": "Leash protects personal AI coding agents with built-in security Features and clear local visibility.",
  "author": "Leash",
  "workspaces": [
    "apps/engine",
    "apps/desktop",
    "apps/flow-viewer",
    "apps/provider-sync-worker",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop": "npm run dev -w @openleash/desktop-client",
    "desktop-client": "npm run dev -w @openleash/desktop-client",
    "desktop-cli": "npm run cli -w @openleash/desktop-client --",
    "dev:engine": "npm run dev -w @openleash/client-api",
    "dev:client-api": "npm run dev:engine",
    "dev:flow-viewer": "npm run dev -w @openleash/flow-viewer",
    "dev:mode:individual-open-source": "docker compose up --build",
    "db:migrate": "npm run db:migrate -w @openleash/client-api --",
    "db:migrate:backup": "npm run db:migrate -w @openleash/client-api -- --backup --apply",
    "db:reset-data": "node scripts/db-reset-data.mjs",
    "schema:snapshot": "python3 snaptshot.py",
    "schema:prepare-migration": "python3 prepare-migration.py",
    "schema:finalize-migration": "python3 finalize-migration.py",
    "test:deployment": "npm run build -w @openleash/shared && node scripts/check-deployment-readiness.mjs",
    "test:deployment:public": "npm run test:deployment",
    "test:flows": "node scripts/check-user-flows.mjs",
    "test:flows:public": "node scripts/check-user-flows.mjs --scope public",
    "test:upgrade": "node scripts/test-postgres-upgrades.mjs && npm rebuild better-sqlite3 && npx tsx scripts/test-desktop-upgrades.mjs",
    "test:local-proxy": "node scripts/test-local-proxy.mjs",
    "docker:build": "node scripts/docker-images.mjs --no-latest",
    "docker:publish": "node scripts/docker-images.mjs --push --no-latest",
    "release:runtime-image": "node scripts/publish-runtime-image.mjs",
    "release:desktop-feed": "node scripts/publish-desktop-update.mjs",
    "smoke:product": "node scripts/check-user-flows.mjs && node scripts/smoke-product-logic.mjs",
    "smoke:product:public": "node scripts/check-user-flows.mjs --scope public && node scripts/smoke-product-logic.mjs",
    "audit:public": "node scripts/audit-public-boundary.mjs",
    "dist:personal": "npm run build -w @openleash/desktop-client && npm run test:island:mac -w @openleash/desktop-client && npx electron-rebuild -v 43.3.0 -w better-sqlite3 --force && node scripts/build-desktop-distributable.mjs --mac",
    "dist:windows": "npm run build -w @openleash/desktop-client && npx electron-rebuild -v 43.3.0 -w better-sqlite3 --force --platform win32 --arch x64 && node scripts/build-desktop-distributable.mjs --windows"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "sharp": "0.35.3",
    "simple-icons": "^16.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4"
  },
  "overrides": {
    "form-data": "4.0.6",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "tsx": {
      "esbuild": "0.28.1"
    }
  },
  "main": "apps/desktop/dist/main.js"
}
